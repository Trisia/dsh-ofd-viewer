# 依赖
node_modules/

# 本项目只用 pnpm，误用 npm 生成的锁文件不纳入版本管理
package-lock.json

# 构建产物（由 scripts/build.mjs 生成）
lib/

# npm 缓存
.build-cache/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# 本地验证素材（示例 OFD、上游解包等）
.probe/
*.tgz

# 编辑器与系统文件
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# 测试与覆盖率产物
coverage/
*.tsbuildinfo

# pnpm pack 产物（本地打包与 CI 发布 Release 附件都用这个目录）
dist/

# 本地测试残留（Playwright 日志/快照、临时缓存与脚本）
.playwright-cli/
.tmp/

# 本地环境变量
.env
.env.*
!.env.example
