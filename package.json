{
  "name": "@cliven/dsh-ofd-viewer",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "OFD document preview for DSH: read OFD in the Sidebar, the OFD panel and composer attachments, plus an ofd_read tool",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trisia/dsh-ofd-viewer.git"
  },
  "homepage": "https://github.com/Trisia/dsh-ofd-viewer#readme",
  "bugs": {
    "url": "https://github.com/Trisia/dsh-ofd-viewer/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ofd",
    "ofdrw",
    "document-preview"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "packageManager": "pnpm@11.24.0",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/**",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-attachment"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-crypto": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@ofdrw/ofdrw-viewer-ui": "^0.1.7"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": ">=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-web-app": ">=0.2.0-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": {
      "optional": true
    },
    "@deepseek-ai/dsh-web-app": {
      "optional": true
    }
  }
}
